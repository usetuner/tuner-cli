{
  "name": "@usetuner.ai/cli",
  "version": "0.2.1",
  "description": "Run Tuner voice-agent simulations from the command line",
  "keywords": [
    "cli",
    "voice-ai",
    "simulations",
    "testing",
    "ci",
    "tuner"
  ],
  "license": "MIT",
  "author": "usetuner <support@usetuner.ai>",
  "homepage": "https://usetuner.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usetuner/tuner-cli.git"
  },
  "type": "module",
  "bin": {
    "tuner": "dist/cli/main.js"
  },
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "gen:openapi": "sh scripts/gen-openapi.sh",
    "gen:types": "openapi-typescript openapi/openapi.json --default-non-nullable false -o src/generated/api.ts",
    "gen": "npm run gen:openapi && npm run gen:types",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
