{
  "name": "@usetuner/cli",
  "version": "0.1.0",
  "description": "Run Tuner voice-agent simulations from the command line",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "tuner": "dist/cli.js"
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "gen:openapi": "sh scripts/gen-openapi.sh",
    "gen:types": "openapi-typescript openapi/openapi.json --default-non-nullable false -o src/generated/api.ts",
    "gen": "npm run gen:openapi && npm run gen:types",
    "prepack": "npm run build"
  },
  "dependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "ajv": "^8.20.0",
    "eslint": "^9.39.5",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
